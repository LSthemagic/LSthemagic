{
  "name": "railan-engineering-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dynamic command-center GitHub profile generated from public telemetry.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/generate.ts",
    "generate:live": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/generate.ts --live",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "validate": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/validate.ts",
    "verify": "npm run test && npm run generate && npm run validate"
  }
}
